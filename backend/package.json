  "version": "1.0.0",
  "description": "Backend API for Stock Market Sentiment Analysis & Kotak Neo Trading Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
